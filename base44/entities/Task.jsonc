{
  "name": "Task",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "title": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0647\u0645\u0629"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "title": "\u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "review",
        "done"
      ],
      "default": "todo",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0633\u062a\u062d\u0642\u0627\u0642"
    },
    "progress": {
      "type": "number",
      "title": "\u0646\u0633\u0628\u0629 \u0627\u0644\u0625\u0646\u062c\u0627\u0632",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    }
  },
  "required": [
    "employee_name",
    "title",
    "priority"
  ]
}