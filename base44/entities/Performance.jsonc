{
  "name": "Performance",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "period": {
      "type": "string",
      "title": "\u0627\u0644\u0641\u062a\u0631\u0629"
    },
    "review_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0642\u064a\u064a\u0645"
    },
    "rating": {
      "type": "number",
      "title": "\u0627\u0644\u062a\u0642\u064a\u064a\u0645",
      "minimum": 1,
      "maximum": 5
    },
    "goals": {
      "type": "string",
      "title": "\u0627\u0644\u0623\u0647\u062f\u0627\u0641"
    },
    "achievements": {
      "type": "string",
      "title": "\u0627\u0644\u0625\u0646\u062c\u0627\u0632\u0627\u062a"
    },
    "strengths": {
      "type": "string",
      "title": "\u0646\u0642\u0627\u0637 \u0627\u0644\u0642\u0648\u0629"
    },
    "improvements": {
      "type": "string",
      "title": "\u0646\u0642\u0627\u0637 \u0627\u0644\u062a\u0637\u0648\u064a\u0631"
    },
    "reviewer": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0642\u064a\u0651\u0645"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "completed"
      ],
      "default": "draft",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    }
  },
  "required": [
    "employee_name",
    "period",
    "rating"
  ]
}