{
  "name": "Salary",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "month": {
      "type": "string",
      "title": "\u0627\u0644\u0634\u0647\u0631"
    },
    "base_salary": {
      "type": "number",
      "title": "\u0627\u0644\u0631\u0627\u062a\u0628 \u0627\u0644\u0623\u0633\u0627\u0633\u064a"
    },
    "allowances": {
      "type": "number",
      "title": "\u0627\u0644\u0628\u062f\u0644\u0627\u062a",
      "default": 0
    },
    "deductions": {
      "type": "number",
      "title": "\u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a",
      "default": 0
    },
    "bonus": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0643\u0627\u0641\u0622\u062a",
      "default": 0
    },
    "net_salary": {
      "type": "number",
      "title": "\u0635\u0627\u0641\u064a \u0627\u0644\u0631\u0627\u062a\u0628"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid"
      ],
      "default": "pending",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062f\u0641\u0639"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "employee_name",
    "month",
    "base_salary"
  ]
}